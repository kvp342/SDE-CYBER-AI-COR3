# Copy to tenantwall.env and fill in. Nothing here is secret: the AWS CLI uses your configured admin profile.
REGION=ap-south-1                 # the region your TenantWall resources are in
DATA_BUCKET=your-tenant-bucket    # the shared bucket with one prefix per team
TEAM_A=TeamA                      # value of the Team tag for team A (also its prefix in the bucket)
TEAM_B=TeamB                      # value of the Team tag for team B
USER_A=alice                      # an IAM user tagged Team=TEAM_A
OWN_KEY=TeamA/test.txt            # an object team A may read
OTHER_KEY=TeamB/test.txt          # an object team A must NOT read
EC2_POLICY=TenantABAC_EC2         # your identity policy names
S3_POLICY=TenantABAC_S3
ALERT_EMAIL=you@example.com       # where alarm emails go (you must click Confirm in the email AWS sends)
