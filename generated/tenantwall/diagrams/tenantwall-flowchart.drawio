<mxfile host="app.diagrams.net"><diagram name="TenantWall method flowchart" id="tenantwall-flowchart"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s" value="A team user sends an AWS request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2F8;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="40" width="240" height="50" as="geometry"/></mxCell><mxCell id="q1" value="Does any explicit Deny match? (NoSelfPromotion, other team&#x27;s prefix, non-TLS)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#ED7100;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="140" width="320" height="110" as="geometry"/></mxCell><mxCell id="r1" value="Refused: EXPLICIT deny" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#D13212;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="165" width="220" height="60" as="geometry"/></mxCell><mxCell id="q2" value="Does an Allow match with Team tag = resource&#x27;s Team tag or prefix?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#ED7100;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="310" width="320" height="110" as="geometry"/></mxCell><mxCell id="r2" value="Refused: IMPLICIT deny (no Allow matched)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#D13212;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="335" width="220" height="60" as="geometry"/></mxCell><mxCell id="ok" value="Allowed: own team&#x27;s data only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5E9;strokeColor=#1E8900;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="480" width="240" height="55" as="geometry"/></mxCell><mxCell id="log" value="CloudTrail records every request (allowed and refused)" style="roun